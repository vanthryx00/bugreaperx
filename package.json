{
  "name": "bugreaper-desktop",
  "version": "4.0.0",
  "description": "BugReaper X — Sovereign Windows Standalone Bug Bounty Automation Suite",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:win": "npm run build && electron-builder --windows",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Wyatt Daryl Fiddler",
  "license": "ISC",
  "dependencies": {
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.7"
  },
  "build": {
    "appId": "com.vanthryx00.bugreaperx",
    "productName": "BugReaperX",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "BugReaperX-${version}-portable.exe"
    },
    "directories": {
      "output": "release"
    }
  }
}
