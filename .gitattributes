# Auto-detect text files and use LF
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.exe binary
*.dll binary
*.pak binary
*.bin binary
*.snapshot_blob.bin binary
*.asar binary

# Batch files need CRLF on Windows
*.bat text eol=crlf
*.cmd text eol=crlf
